{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --workspace ops-web --include-workspace-root --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm run build --workspace ops-web",
  "outputDirectory": "ops-web/out",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/checkin/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sundays-checkin.vercel.app"
        }
      ],
      "destination": "/checkin"
    },
    {
      "source": "/callback",
      "has": [
        {
          "type": "host",
          "value": "sundays-checkin.vercel.app"
        }
      ],
      "destination": "/checkin/callback"
    }
  ]
}
